# ==============================================================================
# PayGuard – Graph-Enhanced Adaptive Hybrid Learning for Digital Payment Fraud Detection
# Environment Configuration
# ==============================================================================

PROJECT_NAME="PayGuard"
PROJECT_TITLE="PayGuard – Graph-Enhanced Adaptive Hybrid Learning for Digital Payment Fraud Detection"
API_PORT=8000
FRONTEND_PORT=5173

# Database URL
# Default is SQLite for seamless local academic execution:
DATABASE_URL=sqlite:///payguard.db
# PostgreSQL option:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/payguard

# Regional & Currency Settings
DEFAULT_CURRENCY=INR
CURRENCY_SYMBOL=₹
LOCALE=en-IN

# Machine Learning & GNN Pipeline
ENABLE_TRAINED_MODEL=false
MODEL_CHECKPOINT_PATH=models/hybrid_fraud_model.pt

# Real-Time Simulator Defaults
SIMULATION_INTERVAL_MS=2000
SAFE_RISK_THRESHOLD=40.0
FRAUD_RISK_THRESHOLD=75.0
